.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable values and saved plans may contain environment-specific or sensitive data.
*.tfvars
*.tfvars.json
!terraform.tfvars.example
tfplan
*.tfplan

# Local overrides and CLI configuration are operator-specific.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# The inventory is generated explicitly from secret-free Terraform outputs.
playbooks/inventory.ini

# Common editor and operating-system noise is not part of the project.
.DS_Store
.idea/
.vscode/
